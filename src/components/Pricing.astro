---
// Pricing section component
---

<section
  id="pricing"
  class="py-20 bg-gradient-to-br from-gray-50 to-gray-100 dark:from-gray-800 dark:to-gray-900 transition-colors duration-200"
>
  <div class="container mx-auto px-4">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold text-gray-900 dark:text-white mb-4">Simple, Flat-Rate Pricing</h2>
      <p class="text-xl text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
        No hidden fees, no surprises. Just honest, transparent pricing based on your property size.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
      <!-- 1 Bedroom -->
      <div
        class="bg-white rounded-xl p-8 shadow-lg hover:shadow-xl transition border-2 border-transparent hover:border-blue-600"
      >
        <div class="text-center mb-6">
          <div class="text-5xl font-bold text-gray-900 mb-2">$80</div>
          <div class="text-gray-600">1 Bedroom</div>
        </div>
        <ul class="space-y-3 mb-8">
          <li class="flex items-start gap-2">
            <svg
              class="w-5 h-5 text-blue-600 mt-0.5 flex-shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span class="text-gray-700 dark:text-gray-200">Full apartment/unit cleaning</span>
          </li>
          <li class="flex items-start gap-2">
            <svg
              class="w-5 h-5 text-blue-600 mt-0.5 flex-shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span class="text-gray-700 dark:text-gray-200">Kitchen & bathroom</span>
          </li>
          <li class="flex items-start gap-2">
            <svg
              class="w-5 h-5 text-blue-600 mt-0.5 flex-shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span class="text-gray-700 dark:text-gray-200">Living area</span>
          </li>
          <li class="flex items-start gap-2">
            <svg
              class="w-5 h-5 text-blue-600 mt-0.5 flex-shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span class="text-gray-700">Photo report included</span>
          </li>
        </ul>
        <a
          href="#contact"
          class="block w-full bg-blue-600 text-white text-center px-6 py-3 rounded-lg font-semibold hover:bg-blue-700 transition"
        >
          Book Now
        </a>
      </div>

      <!-- 2 Bedroom -->
      <div
        class="bg-blue-600 text-white rounded-xl p-8 shadow-xl hover:shadow-2xl transition transform hover:-translate-y-1 relative"
      >
        <div
          class="absolute -top-4 left-1/2 transform -translate-x-1/2 bg-yellow-400 text-gray-900 px-4 py-1 rounded-full text-sm font-bold"
        >
          MOST POPULAR
        </div>
        <div class="text-center mb-6">
          <div class="text-5xl font-bold mb-2">$110</div>
          <div class="text-blue-100">2 Bedrooms</div>
        </div>
        <ul class="space-y-3 mb-8">
          <li class="flex items-start gap-2">
            <svg class="w-5 h-5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>Full home/unit cleaning</span>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-5 h-5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>Kitchen & bathrooms</span>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-5 h-5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>All living areas</span>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-5 h-5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>Photo report included</span>
          </li>
        </ul>
        <a
          href="#contact"
          class="block w-full bg-white text-blue-600 text-center px-6 py-3 rounded-lg font-semibold hover:bg-gray-100 transition"
        >
          Book Now
        </a>
      </div>

      <!-- 3 Bedroom -->
      <div
        class="bg-white rounded-xl p-8 shadow-lg hover:shadow-xl transition border-2 border-transparent hover:border-blue-600"
      >
        <div class="text-center mb-6">
          <div class="text-5xl font-bold text-gray-900 mb-2">$140</div>
          <div class="text-gray-600">3 Bedrooms</div>
        </div>
        <ul class="space-y-3 mb-8">
          <li class="flex items-start gap-2">
            <svg
              class="w-5 h-5 text-blue-600 mt-0.5 flex-shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span class="text-gray-700">Full home/unit cleaning</span>
          </li>
          <li class="flex items-start gap-2">
            <svg
              class="w-5 h-5 text-blue-600 mt-0.5 flex-shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span class="text-gray-700">Kitchen & bathrooms</span>
          </li>
          <li class="flex items-start gap-2">
            <svg
              class="w-5 h-5 text-blue-600 mt-0.5 flex-shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span class="text-gray-700">All living areas</span>
          </li>
          <li class="flex items-start gap-2">
            <svg
              class="w-5 h-5 text-blue-600 mt-0.5 flex-shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span class="text-gray-700">Photo report included</span>
          </li>
        </ul>
        <a
          href="#contact"
          class="block w-full bg-blue-600 text-white text-center px-6 py-3 rounded-lg font-semibold hover:bg-blue-700 transition"
        >
          Book Now
        </a>
      </div>
    </div>

    <div class="mt-12 text-center">
      <p class="text-gray-600 dark:text-gray-300 mb-4">
        Need a custom quote for larger properties or special requirements?
      </p>
      <a
        href="#contact"
        class="text-blue-600 dark:text-blue-400 font-semibold hover:text-blue-700 dark:hover:text-blue-300 transition"
      >
        Contact us for a personalized quote →
      </a>
    </div>
  </div>
</section>

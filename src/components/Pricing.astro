---
// Pricing section component
---

<section
  id="pricing"
  class="py-20 bg-gradient-to-br from-gray-50 to-gray-100 dark:from-gray-800 dark:to-gray-900 transition-colors duration-200"
>
  <div class="container mx-auto px-4">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold text-gray-900 dark:text-white mb-4">Simple, Flat-Rate Pricing</h2>
      <p class="text-xl text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
        No hidden fees, no surprises. Just honest, transparent pricing based on your property size.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-12 max-w-5xl mx-auto">
      <!-- Regular Cleaning -->
      <div>
        <h3 class="text-2xl font-bold text-center text-gray-900 dark:text-white mb-6">Regular Cleaning</h3>
        <div class="grid grid-cols-2 gap-4">
          <!-- 1 Bedroom -->
          <div
            class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-lg hover:shadow-xl transition border-2 border-transparent hover:border-blue-600 dark:border-gray-700 dark:hover:border-blue-500"
          >
            <div class="text-center mb-4">
              <div class="text-4xl font-bold text-gray-900 dark:text-white mb-1">$90</div>
              <div class="text-gray-600 dark:text-gray-300">1 Bedroom</div>
            </div>
            <a
              href="#contact"
              class="block w-full bg-blue-600 text-white text-center px-4 py-2 rounded-lg font-semibold hover:bg-blue-700 transition"
            >
              Book Now
            </a>
          </div>

          <!-- 2 Bedroom -->
          <div
            class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-lg hover:shadow-xl transition border-2 border-transparent hover:border-blue-600 dark:border-gray-700 dark:hover:border-blue-500"
          >
            <div class="text-center mb-4">
              <div class="text-4xl font-bold text-gray-900 dark:text-white mb-1">$120</div>
              <div class="text-gray-600 dark:text-gray-300">2 Bedrooms</div>
            </div>
            <a
              href="#contact"
              class="block w-full bg-blue-600 text-white text-center px-4 py-2 rounded-lg font-semibold hover:bg-blue-700 transition"
            >
              Book Now
            </a>
          </div>

          <!-- 3 Bedroom -->
          <div
            class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-lg hover:shadow-xl transition border-2 border-transparent hover:border-blue-600 dark:border-gray-700 dark:hover:border-blue-500"
          >
            <div class="text-center mb-4">
              <div class="text-4xl font-bold text-gray-900 dark:text-white mb-1">$150</div>
              <div class="text-gray-600 dark:text-gray-300">3 Bedrooms</div>
            </div>
            <a
              href="#contact"
              class="block w-full bg-blue-600 text-white text-center px-4 py-2 rounded-lg font-semibold hover:bg-blue-700 transition"
            >
              Book Now
            </a>
          </div>

          <!-- 4 Bedroom -->
          <div
            class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-lg hover:shadow-xl transition border-2 border-transparent hover:border-blue-600 dark:border-gray-700 dark:hover:border-blue-500"
          >
            <div class="text-center mb-4">
              <div class="text-4xl font-bold text-gray-900 dark:text-white mb-1">$180</div>
              <div class="text-gray-600 dark:text-gray-300">4 Bedrooms</div>
            </div>
            <a
              href="#contact"
              class="block w-full bg-blue-600 text-white text-center px-4 py-2 rounded-lg font-semibold hover:bg-blue-700 transition"
            >
              Book Now
            </a>
          </div>
        </div>
      </div>

      <!-- Deep Cleaning -->

---
// Header component with navigation
---

<header class="fixed w-full bg-white dark:bg-gray-800 shadow-sm z-50 transition-colors duration-200">
  <nav class="container mx-auto px-4 py-1 flex justify-between items-center">
    <a href="/" class="flex items-center">
      <svg class="h-18 w-auto" viewBox="0 0 620 220" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Water droplet -->
        <g transform="translate(0, 20)">
          <!-- Droplet shape with gradient -->
          <defs>
            <linearGradient id="dropletGradient" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" style="stop-color:#a8d5e2;stop-opacity:1"></stop>
              <stop offset="100%" style="stop-color:#7cb8d1;stop-opacity:1"></stop>
            </linearGradient>
          </defs>
          <path
            d="M70 35 C70 35, 45 65, 45 90 C45 115, 55 130, 70 130 C85 130, 95 115, 95 90 C95 65, 70 35, 70 35 Z"
            fill="url(#dropletGradient)"
            stroke="none"></path>

          <!-- Sparkles inside droplet -->
          <g fill="white">
            <!-- Large star -->
            <path d="M62 70 L64 76 L70 78 L64 80 L62 86 L60 80 L54 78 L60 76 Z"></path>
            <!-- Medium star -->
            <path d="M75 85 L76 88 L79 89 L76 90 L75 93 L74 90 L71 89 L74 88 Z"></path>
            <!-- Small star -->
            <path d="M68 95 L68.5 96.5 L70 97 L68.5 97.5 L68 99 L67.5 97.5 L66 97 L67.5 96.5 Z"></path>
          </g>
        </g>

        <!-- Text -->
        <g fill="currentColor" class="text-gray-900 dark:text-white" transform="translate(0, 20)">
          <!-- "The Tidy Gal" -->
          <text x="130" y="80" font-family="serif" font-size="58" font-weight="400" letter-spacing="-1"
            >The Tidy Gal</text
          >

          <!-- "Home Cleaning" in script style -->
          <text
            x="145"
            y="130"
            font-family="cursive"
            font-size="38"
            font-weight="300"
            font-style="italic"
            letter-spacing="1">Home Cleaning</text
          >
        </g>
      </svg>
    </a>

    <!-- Desktop Navigation -->
    <ul class="hidden md:flex gap-6 items-center">
      <li>
        <a
          href="#services"
          class="text-gray-700 dark:text-gray-200 hover:text-blue-600 dark:hover:text-blue-400 transition">Services</a
        >
      </li>
      <li>
        <a
          href="#pricing"
          class="text-gray-700 dark:text-gray-200 hover:text-blue-600 dark:hover:text-blue-400 transition">Pricing</a
        >
      </li>
      <!-- <li>
        <a
          href="#gallery"
          class="text-gray-700 dark:text-gray-200 hover:text-blue-600 dark:hover:text-blue-400 transition">Gallery</a
        >
      </li> -->
      <li>
        <a
          href="#testimonials"
          class="text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 transition"
          >Testimonials</a
        >
      </li>
      <li>
        <a
          href="#contact"
          class="bg-blue-600 dark:bg-blue-500 text-white px-4 py-2 rounded-lg hover:bg-blue-700 dark:hover:bg-blue-600 transition"
          >Contact</a
        >
      </li>
      <!-- Dark Mode Toggle -->
      <li>
        <button
          id="theme-toggle"
          class="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition"
          aria-label="Toggle dark mode"
        >
          <svg
            id="theme-toggle-dark-icon"
            class="hidden w-5 h-5 text-gray-700 dark:text-gray-300"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
          </svg>
          <svg
            id="theme-toggle-light-icon"
            class="hidden w-5 h-5 text-gray-700 dark:text-gray-300"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
              fill-rule="evenodd"
              clip-rule="evenodd"></path>
          </svg>
        </button>
      </li>
    </ul>

    <!-- Mobile Menu & Theme Toggle -->
    <div class="flex items-center gap-2 md:hidden">
      <button
        id="theme-toggle-mobile"
        class="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition"
        aria-label="Toggle dark mode"
      >
        <svg
          id="theme-toggle-dark-icon-mobile"
          class="hidden w-5 h-5 text-gray-700 dark:text-gray-300"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
        </svg>
        <svg
          id="theme-toggle-light-icon-mobile"
          class="hidden w-5 h-5 text-gray-700 dark:text-gray-300"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
            fill-rule="evenodd"
            clip-rule="evenodd"></path>
        </svg>
      </button>
      <button id="mobile-menu-btn" class="text-gray-700 dark:text-gray-300">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Navigation -->
  <div
    id="mobile-menu"
    class="hidden absolute top-full left-0 right-0 bg-white dark:bg-gray-800 border-t dark:border-gray-700 shadow-lg z-40"
  >
    <ul class="px-4 py-4 flex flex-col gap-3">
      <li>
        <a
          href="#services"
          class="block text-gray-700 dark:text-gray-200 hover:text-blue-600 dark:hover:text-blue-400 transition py-2"
          >Services</a
        >
      </li>
      <li>
        <a
          href="#pricing"
          class="block text-gray-700 dark:text-gray-200 hover:text-blue-600 dark:hover:text-blue-400 transition py-2"
          >Pricing</a
        >
      </li>
      <!-- <li>
        <a
          href="#gallery"
          class="block text-gray-700 dark:text-gray-200 hover:text-blue-600 dark:hover:text-blue-400 transition py-2"
          >Gallery</a
        >
      </li>
      <li> -->
      <a
        href="#testimonials"
        class="block text-gray-700 dark:text-gray-200 hover:text-blue-600 dark:hover:text-blue-400 transition py-2"
        >Testimonials</a
      >
    </ul>
    <li>
      <a
        href="#contact"
        class="block bg-blue-600 dark:bg-blue-500 text-white px-4 py-3 rounded-lg hover:bg-blue-700 dark:hover:bg-blue-600 transition text-center"
        >Contact</a
      >
    </li>
  </div>
</header>

<script>
  // Theme toggle functionality
  function updateThemeIcons() {
    const isDark = document.documentElement.classList.contains('dark');

    // Desktop icons
    document.getElementById('theme-toggle-dark-icon')?.classList.toggle('hidden', !isDark);
    document.getElementById('theme-toggle-light-icon')?.classList.toggle('hidden', isDark);

    // Mobile icons
    document.getElementById('theme-toggle-dark-icon-mobile')?.classList.toggle('hidden', !isDark);
    document.getElementById('theme-toggle-light-icon-mobile')?.classList.toggle('hidden', isDark);
  }

  function toggleTheme() {
    if (document.documentElement.classList.contains('dark')) {
      document.documentElement.classList.remove('dark');
      localStorage.theme = 'light';
    } else {
      document.documentElement.classList.add('dark');
      localStorage.theme = 'dark';
    }
    updateThemeIcons();
  }

  // Initialize theme icons
  updateThemeIcons();

  // Add click listeners to theme toggle buttons
  document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
  document.getElementById('theme-toggle-mobile')?.addEventListener('click', toggleTheme);

  // Mobile menu toggle
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  // Close mobile menu when clicking on a link
  const mobileLinks = mobileMenu?.querySelectorAll('a');
  mobileLinks?.forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
    });
  });
</script>

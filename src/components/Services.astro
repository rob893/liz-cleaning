---
// Services section component
---

<section id="services" class="py-20 bg-white dark:bg-gray-900 transition-colors duration-200">
  <div class="container mx-auto px-4">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold text-gray-900 dark:text-white mb-4">Our Services</h2>
      <p class="text-xl text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
        Professional cleaning solutions tailored to your needs
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
      <!-- Residential Cleaning -->
      <div
        class="bg-gradient-to-br from-blue-50 to-blue-100 dark:from-blue-900/20 dark:to-blue-800/20 rounded-xl p-8 shadow-lg hover:shadow-xl transition"
      >
        <div class="w-16 h-16 bg-blue-600 dark:bg-blue-500 rounded-lg flex items-center justify-center mb-6">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
            ></path>
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Residential Cleaning</h3>
        <p class="text-gray-700 dark:text-gray-200 mb-4">
          Keep your home spotless with our thorough residential cleaning services. We handle everything from bedrooms to
          bathrooms.
        </p>
        <ul class="space-y-2 text-gray-700 dark:text-gray-200">
          <li class="flex items-start gap-2">
            <svg
              class="w-5 h-5 text-green-600 mt-0.5 flex-shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>Deep cleaning & dusting</span>
          </li>
          <li class="flex items-start gap-2">
            <svg
              class="w-5 h-5 text-green-600 mt-0.5 flex-shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>Kitchen & bathroom sanitization</span>
          </li>
          <li class="flex items-start gap-2">
            <svg
              class="w-5 h-5 text-green-600 mt-0.5 flex-shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>Vacuum & mop floors</span>
          </li>
        </ul>
      </div>

      <!-- Commercial Cleaning -->
      <div
        class="bg-gradient-to-br from-green-50 to-green-100 dark:from-green-900/20 dark:to-green-800/20 rounded-xl p-8 shadow-lg hover:shadow-xl transition"
      >
        <div class="w-16 h-16 bg-green-600 dark:bg-green-500 rounded-lg flex items-center justify-center mb-6">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
            ></path>
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Commercial Cleaning</h3>
        <p class="text-gray-700 dark:text-gray-200 mb-4">
          Maintain a professional, clean workspace for your employees and customers with our commercial cleaning
          services.
        </p>
        <ul class="space-y-2 text-gray-700 dark:text-gray-200">
          <li class="flex items-start gap-2">
            <svg
              class="w-5 h-5 text-green-600 mt-0.5 flex-shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>Office & workspace cleaning</span>
          </li>
          <li class="flex items-start gap-2">
            <svg
              class="w-5 h-5 text-green-600 mt-0.5 flex-shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>Restroom sanitization</span>
          </li>
          <li class="flex items-start gap-2">
            <svg
              class="w-5 h-5 text-green-600 mt-0.5 flex-shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>Common area maintenance</span>
          </li>
        </ul>
      </div>

      <!-- Airbnb Turnover -->
      <div
        class="bg-gradient-to-br from-purple-50 to-purple-100 dark:from-purple-900/20 dark:to-purple-800/20 rounded-xl p-8 shadow-lg hover:shadow-xl transition"
      >
        <div class="w-16 h-16 bg-purple-600 dark:bg-purple-500 rounded-lg flex items-center justify-center mb-6">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Airbnb Turnover</h3>
        <p class="text-gray-700 dark:text-gray-200 mb-4">
          Fast, reliable turnover cleaning for short-term rentals with after-clean photo reports.
        </p>
        <ul class="space-y-2 text-gray-700 dark:text-gray-200">
          <li class="flex items-start gap-2">
            <svg
              class="w-5 h-5 text-green-600 mt-0.5 flex-shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>After-clean photos sent</span>
          </li>
          <li class="flex items-start gap-2">
            <svg
              class="w-5 h-5 text-green-600 mt-0.5 flex-shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>Issue reporting & backup service</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

---
// Gallery section component
---

<section
  id="gallery"
  class="py-20 bg-gradient-to-br from-gray-50 to-gray-100 dark:from-gray-800 dark:to-gray-900 transition-colors duration-200"
>
  <div class="container mx-auto px-4">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold text-gray-900 dark:text-white mb-4">Our Work</h2>
      <p class="text-xl text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
        See the difference professional cleaning makes
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 max-w-6xl mx-auto">
      <!-- Gallery Item 1 -->
      <div class="group relative overflow-hidden rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300">
        <div class="aspect-square bg-gradient-to-br from-blue-200 to-blue-300 flex items-center justify-center">
          <div class="text-center p-8">
            <svg class="w-20 h-20 text-white mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"
              ></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"
              ></path>
            </svg>
            <p class="text-white font-semibold">Kitchen Cleaning</p>
            <p class="text-blue-100 text-sm mt-2">Sparkling clean surfaces</p>
          </div>
        </div>
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end"
        >
          <div class="p-6 text-white">
            <p class="font-semibold">Before & After</p>
            <p class="text-sm text-gray-200">Professional kitchen deep clean</p>
          </div>
        </div>
      </div>

      <!-- Gallery Item 2 -->
      <div class="group relative overflow-hidden rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300">
        <div class="aspect-square bg-gradient-to-br from-green-200 to-green-300 flex items-center justify-center">
          <div class="text-center p-8">
            <svg class="w-20 h-20 text-white mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"
              ></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"
              ></path>
            </svg>
            <p class="text-white font-semibold">Bathroom Cleaning</p>
            <p class="text-green-100 text-sm mt-2">Fresh and sanitized</p>
          </div>
        </div>
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end"
        >
          <div class="p-6 text-white">
            <p class="font-semibold">Before & After</p>
            <p class="text-sm text-gray-200">Complete bathroom sanitization</p>
          </div>
        </div>
      </div>

      <!-- Gallery Item 3 -->
      <div class="group relative overflow-hidden rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300">
        <div class="aspect-square bg-gradient-to-br from-purple-200 to-purple-300 flex items-center justify-center">
          <div class="text-center p-8">
            <svg class="w-20 h-20 text-white mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"
              ></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"
              ></path>
            </svg>
            <p class="text-white font-semibold">Living Room</p>
            <p class="text-purple-100 text-sm mt-2">Pristine living spaces</p>
          </div>
        </div>
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end"
        >
          <div class="p-6 text-white">
            <p class="font-semibold">Before & After</p>
            <p class="text-sm text-gray-200">Detailed living area cleaning</p>
          </div>
        </div>
      </div>

      <!-- Gallery Item 4 -->
      <div class="group relative overflow-hidden rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300">
        <div class="aspect-square bg-gradient-to-br from-yellow-200 to-yellow-300 flex items-center justify-center">
          <div class="text-center p-8">
            <svg class="w-20 h-20 text-white mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"
              ></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"
              ></path>
            </svg>
            <p class="text-white font-semibold">Airbnb Turnover</p>
            <p class="text-yellow-100 text-sm mt-2">Guest-ready perfection</p>
          </div>
        </div>
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end"
        >
          <div class="p-6 text-white">
            <p class="font-semibold">Before & After</p>
            <p class="text-sm text-gray-200">Quick turnover cleaning</p>
          </div>
        </div>
      </div>

      <!-- Gallery Item 5 -->
      <div class="group relative overflow-hidden rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300">
        <div class="aspect-square bg-gradient-to-br from-pink-200 to-pink-300 flex items-center justify-center">
          <div class="text-center p-8">
            <svg class="w-20 h-20 text-white mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"
              ></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"
              ></path>
            </svg>
            <p class="text-white font-semibold">Commercial Space</p>
            <p class="text-pink-100 text-sm mt-2">Professional workspace</p>
          </div>
        </div>
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end"
        >
          <div class="p-6 text-white">
            <p class="font-semibold">Before & After</p>
            <p class="text-sm text-gray-200">Office deep cleaning</p>
          </div>
        </div>
      </div>

      <!-- CTA Gallery Item -->
      <div
        class="group relative overflow-hidden rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 bg-blue-600 flex items-center justify-center"
      >
        <div class="text-center p-8">
          <svg class="w-16 h-16 text-white mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          <p class="text-white font-bold text-xl mb-2">Your Photos Here!</p>
          <p class="text-blue-100 mb-4">Book a cleaning today</p>
          <a
            href="#contact"
            class="inline-block bg-white text-blue-600 px-6 py-2 rounded-lg font-semibold hover:bg-gray-100 transition"
          >
            Contact Us
          </a>
        </div>
      </div>
    </div>

    <div class="text-center mt-12">
      <p class="text-gray-600 dark:text-gray-400">All photos sent directly to you after each cleaning session</p>
    </div>
  </div>
</section>
